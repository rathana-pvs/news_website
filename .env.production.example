# ── Database ───────────────────────────────────────────────────────
# These populate the PostgreSQL container and connection string
POSTGRES_USER=tribune
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
POSTGRES_DB=tribune

# ── Payload CMS ────────────────────────────────────────────────────
# Generate a secure 32-byte secret with: openssl rand -hex 32
PAYLOAD_SECRET=CHANGE_THIS_TO_A_RANDOM_32_CHAR_STRING

# ── Cloudinary (Media Storage) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# ── Site Metadata ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://asiandot.com
NEXT_PUBLIC_SITE_NAME=Asian Dot
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Supabase (Frontend Integration) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Google Gemini AI (Content Writing Assistant) ───────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
